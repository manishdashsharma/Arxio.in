# ── Required ──────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net
MONGODB_DB_NAME=arxio

REDIS_URL=rediss://:<password>@<host>.upstash.io:6379

JWT_SECRET=change-this-to-a-long-random-secret

# ── App ───────────────────────────────────────────────
ENVIRONMENT=production
CORS_ORIGINS=["https://app.arxio.in"]

# ── Email (Resend) ────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@arxio.in

# ── AI ───────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxx
TAVILY_API_KEY=tvly-xxxxxxxxxxxx

# ── Cloudflare R2 ────────────────────────────────────
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=arxio
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# ── Qdrant (Scholar plan only) ───────────────────────
QDRANT_URL=
QDRANT_API_KEY=

# ── Billing ──────────────────────────────────────────
SUBSCRIPTION_ACCESS_KEY=your-early-access-secret-key
